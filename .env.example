# --- WhatsApp Cloud API (app de Meta) ---
# Secreto de la app: firma los webhooks (X-Hub-Signature-256).
WHATSAPP_APP_SECRET=
# Texto que inventas y pegas en Meta al registrar el webhook.
WHATSAPP_VERIFY_TOKEN=
# Token de usuario del sistema con permiso sobre el número.
WHATSAPP_TOKEN=
# Id del número que atiende el bot de Fluver, solo si Meta le entrega directo a Rocket.
# Con Chatwoot se deja vacío: Meta le entrega a Chatwoot.
FLUVER_WHATSAPP_PHONE_NUMBER_ID=
GRAPH_API_VERSION=v23.0

# --- Claude ---
ANTHROPIC_API_KEY=

# --- MCP de Fluver (fluver-web /api/mcp) ---
FLUVER_MCP_URL=https://www.fluver.co/api/mcp
# El mismo valor que ROCKET_MCP_SECRET en fluver-web.
FLUVER_MCP_SECRET=

# --- Memoria (Upstash Redis). Sin estas dos, se usa memoria local: solo para desarrollo. ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Chatwoot (bandeja del equipo). Rocket es su Agent Bot: /webhooks/chatwoot/fluver ---
FLUVER_CHATWOOT_URL=
FLUVER_CHATWOOT_ACCOUNT_ID=
# Token y secreto del Agent Bot (Ajustes → Bots en Chatwoot).
FLUVER_CHATWOOT_BOT_TOKEN=
FLUVER_CHATWOOT_WEBHOOK_SECRET=

# --- Opcional: aviso al equipo cuando el bot escala ---
FLUVER_SLACK_WEBHOOK_URL=
